<UserControl x:Class="ChromeHub.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,30"/>
        
        <!-- Theme Settings -->
        <Border Grid.Row="1" Background="{DynamicResource WidgetBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Appearance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Theme:" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Style="{DynamicResource ComboBoxStyle}" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Animation Settings -->
        <Border Grid.Row="2" Background="{DynamicResource WidgetBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <CheckBox IsChecked="{Binding Settings.EnableAnimations}" Foreground="{DynamicResource TextBrush}" Content="Enable Animations" FontSize="14" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Animation Speed:" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="{Binding Settings.AnimationSpeed}" Style="{DynamicResource SliderStyle}" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Browser Settings -->
        <Border Grid.Row="3" Background="{DynamicResource WidgetBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Browser" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Default Browser:" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedBrowser}" Style="{DynamicResource ComboBoxStyle}" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Notification Settings -->
        <Border Grid.Row="4" Background="{DynamicResource WidgetBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <CheckBox IsChecked="{Binding Settings.EnableNotifications}" Foreground="{DynamicResource TextBrush}" Content="Enable Notifications" FontSize="14" Margin="0,0,0,15"/>
                <CheckBox IsChecked="{Binding Settings.AutoArrangeWidgets}" Foreground="{DynamicResource TextBrush}" Content="Auto-Arrange Widgets" FontSize="14"/>
            </StackPanel>
        </Border>
        
        <!-- Save Button -->
        <Button Grid.Row="5" Content="Save Settings" Click="OnSaveSettings" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,10" Width="150" HorizontalAlignment="Left" Margin="0,0,0,20"/>
    </Grid>
</UserControl>