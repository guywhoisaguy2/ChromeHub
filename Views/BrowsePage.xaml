<UserControl x:Class="ChromeHub.Views.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Browse the Web" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>
        
        <!-- Search Bar -->
        <Border Grid.Row="1" Background="{DynamicResource WidgetBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="16" Padding="10" Background="Transparent" Foreground="{DynamicResource TextBrush}" 
                         CaretBrush="{DynamicResource TextBrush}" BorderThickness="0" 
                         PreviewKeyDown="OnSearchKeyDown" Placeholder="Enter URL or search query..."/>
                
                <Button Grid.Column="1" Content="🔍 Search" Click="OnSearchClick" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,5" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        
        <!-- Info Section -->
        <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Enter a URL or search query" FontSize="18" Foreground="{DynamicResource SubtextBrush}" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Examples:" FontSize="14" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="• google.com" FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="• https://example.com" FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="• search terms" FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,5"/>
        </StackPanel>
    </Grid>
</UserControl>