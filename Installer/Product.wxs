<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="Chrome Hub" Language="1033" Version="1.0.0.0" Manufacturer="Chrome Hub" UpgradeCode="87654321-4321-4321-4321-210987654321">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
        <Media Id="1" Cabinet="ChromeHub.cab" EmbedCab="yes" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        
        <UIRef Id="WixUI_InstallDir" />
        <UIRef Id="WixUI_ErrorProgressText" />
        
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <Property Id="ALLUSERS" Value="1" />

        <Feature Id="ProductFeature" Title="Chrome Hub" Level="1" Description="Modern desktop hub with customizable widgets">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentRef Id="ProgramMenuShortcut" />
            <ComponentRef Id="DesktopShortcut" />
        </Feature>
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFilesFolder">
                <Directory Id="INSTALLFOLDER" Name="Chrome Hub" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Chrome Hub" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <!-- Main executable and all dependencies will be included -->
            <Component Id="MainExecutable" Guid="*">
                <File Id="ChromeHubExe" Source="$(var.PublishDir)ChromeHub.exe" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>

    <Fragment>
        <Component Id="ProgramMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
            <Shortcut Id="ApplicationStartMenuShortcut" Name="Chrome Hub" Description="Modern Desktop Hub with Widgets" Target="[INSTALLFOLDER]ChromeHub.exe" WorkingDirectory="INSTALLFOLDER" Icon="ChromeHubIcon.ico" />
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Chrome Hub" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
    </Fragment>

    <Fragment>
        <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
            <Shortcut Id="DesktopShortcutIcon" Name="Chrome Hub" Description="Modern Desktop Hub with Widgets" Target="[INSTALLFOLDER]ChromeHub.exe" WorkingDirectory="INSTALLFOLDER" Icon="ChromeHubIcon.ico" />
            <RegistryValue Root="HKCU" Key="Software\Chrome Hub" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
    </Fragment>
</Wix>