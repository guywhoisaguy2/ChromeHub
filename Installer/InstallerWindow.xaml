<Window x:Class="ChromeHub.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chrome Hub Installer" Height="500" Width="600"
        Background="#202020" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Installer/logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="30,30,30,30">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Chrome Hub" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Modern Desktop Hub with Widgets" FontSize="14" Foreground="#B0E7FF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="30" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Welcome to Chrome Hub Installer" FontSize="16" Foreground="#FFFFFF" Margin="0,0,0,20"/>
            
            <!-- Installation Steps -->
            <StackPanel Orientation="Vertical" Margin="0,0,0,30">
                <TextBlock Text="Installation will:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                <TextBlock Text="• Install Chrome Hub to Program Files" FontSize="12" Foreground="#B0B0B0" Margin="15,0,0,5"/>
                <TextBlock Text="• Create Start Menu shortcuts" FontSize="12" Foreground="#B0B0B0" Margin="15,0,0,5"/>
                <TextBlock Text="• Create Desktop shortcut" FontSize="12" Foreground="#B0B0B0" Margin="15,0,0,5"/>
                <TextBlock Text="• Register in Programs and Features" FontSize="12" Foreground="#B0B0B0" Margin="15,0,0,0"/>
            </StackPanel>
            
            <!-- Progress Bar -->
            <ProgressBar x:Name="InstallProgress" Height="8" Background="#3D3D3D" Foreground="#0078D4" Margin="0,0,0,15"/>
            
            <!-- Progress Text -->
            <TextBlock x:Name="ProgressText" Text="Ready to install..." FontSize="12" Foreground="#B0B0B0" TextAlignment="Center" Margin="0,0,0,20"/>
        </StackPanel>
        
        <!-- Separator -->
        <Border Grid.Row="2" Height="1" Background="#404040"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,20" Height="40">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Width="120" Margin="0,0,10,0" Style="{DynamicResource CancelButtonStyle}"/>
            <Button x:Name="InstallButton" Content="Install" Click="OnInstall" Width="120" Style="{DynamicResource PrimaryInstallButtonStyle}"/>
        </StackPanel>
    </Grid>
    
    <Window.Resources>
        <Style x:Key="PrimaryInstallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#606060"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>